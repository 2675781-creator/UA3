<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'Supprimer un auteur' }) %>
    <body>
        <%- include('../partials/header') %>
            <main class="wrapper">
                <h1>Supprimer un auteur</h1>
                <form action="/auteurs/<%= auteur.id_auteur %>?_method=DELETE" method="POST" enctype="multipart/form-data">
                    <div class="mb-2">
                        <label for="nom" class="form-label">Nom</label>
                        <input type="text" class="form-control" id="nom" name="nom" value="<%= auteur.nom %>" readonly>
                    </div>
                    <div class="mb-2">
                        <label for="prenom" class="form-label">Prenom</label>
                        <input type="text" class="form-control" id="prenom" name="prenom" value="<%= auteur.prenom %>" readonly>
                    </div>
                    <div class="mb-2">
                        <label for="age" class="form-label">Age</label>
                        <input type="number" class="form-control" id="age" name="age" value="<%= auteur.age %>" readonly>
                    </div>
                    <div class="mb-2">
                        <label for="nationnalite" class="form-label">Nationnalite</label>
                        <input type="text" class="form-control" id="nationnalite" name="nationnalite" value="<%= auteur.nationnalite %>" readonly>
                    </div>
                    <div class="mb-2">
                        <label for="langue" class="form-label">Langue</label>
                        <input type="text" class="form-control" id="langue" name="langue" value="<%= auteur.langue %>" readonly>
                    </div>            
                    <button class="btn btn-success" type="submit">Supprimer</button>
                </form>
            </main>
            <%- include('../partials/footer') %>
    </body>
</html>