<!DOCTYPE html>
<html lang="fr">
  <head>
    <%- include('../partials/head', { title }) %>
  </head>
  <body class="bg-light">
    <%- include('../partials/header') %>

    <main class="container py-5">
      <!-- Ligne "connecté en tant que..." -->
      <div class="mb-3">
        <% if (user) { %>
          <p class="text-muted mb-1">
            Connecté en tant que <strong><%= user.username %></strong>
          </p>
        <% } else { %>
          <a href="/auth/login" class="btn btn-outline-primary btn-sm">
            Se connecter
          </a>
        <% } %>
      </div>

      <!-- Carte profil auteur -->
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="card shadow-sm mb-4">
            <div class="card-body">
              <!-- Titre + bouton retour / édition -->
              <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                <h1 class="h3 mb-0">
                  <%= auteur.prenom %> <%= auteur.nom %>
                </h1>
                <div class="mt-2 mt-sm-0">
                  <a href="/auteurs" class="btn btn-outline-secondary btn-sm me-2">
                    Retour à la liste
                  </a>
                  <a href="/auteurs/<%= auteur.id_auteur %>/edit" class="btn btn-primary btn-sm">
                    Modifier l'auteur
                  </a>
                </div>
              </div>

              <% if (erreur) { %>
                <div class="alert alert-danger">
                  <%= erreur %>
                </div>
              <% } %>

              <!-- Ici tu peux afficher d'autres infos auteur si tu en as -->
              <!-- Exemple :
              <p class="mb-0 text-muted">Email : <%= auteur.email %></p>
              -->
            </div>
          </div>

          <!-- Liste des articles -->
          <div class="card shadow-sm">
            <div class="card-body">
              <h2 class="h4 mb-4">Articles de cet auteur</h2>

              <% if (!articles || articles.length === 0) { %>
                <div class="alert alert-info mb-0">
                  Aucun article pour cet auteur.
                </div>
              <% } else { %>
                <div class="list-group">
                  <% articles.forEach(article => { %>
                    <a
                      href="/articles/<%= article.id_article %>"
                      class="list-group-item list-group-item-action"
                    >
                      <div class="d-flex w-100 justify-content-between">
                        <h3 class="h6 mb-1"><%= article.titre %></h3>
                        <small class="text-muted">
                          <% if (article.date_publication) { %>
                            <%= new Date(article.date_publication).toISOString().substring(0, 10) %>
                          <% } else { %>
                            N/A
                          <% } %>
                        </small>
                      </div>

                      <p class="mb-1">
                        <strong>Status :</strong> <%= article.status %> |
                        <strong>Quantité :</strong> <%= article.quantite %>
                      </p>
                    </a>
                  <% }) %>
                </div>
              <% } %>
            </div>
          </div>

        </div>
      </div>
    </main>

    <%- include('../partials/footer') %>
  </body>
</html>