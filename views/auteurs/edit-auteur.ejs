<!DOCTYPE html>
<html lang="fr">
  <head>
    <%- include('../partials/head', { title }) %>
  </head>
  <body>
    <%- include('../partials/header') %>

    <main class="wrapper">
      <h1>Modifier un auteur</h1>

      <% if (erreur) { %>
        <p style="color:red;"><%= erreur %></p>
      <% } %>

      <form action="/auteurs/<%= auteur.id_auteur %>/edit" method="post">
        <label for="nom">Nom</label>
        <input
          type="text"
          id="nom"
          name="nom"
          value="<%= auteur.nom %>"
          required
        >

        <label for="prenom">Prénom</label>
        <input
          type="text"
          id="prenom"
          name="prenom"
          value="<%= auteur.prenom %>"
          required
        >

        <label for="age">Âge</label>
        <input
          type="number"
          id="age"
          name="age"
          value="<%= auteur.age %>"
          required
        >

        <label for="nationalite">Nationalité</label>
        <input
          type="text"
          id="nationalite"
          name="nationalite"
          value="<%= auteur.nationalite %>"
          required
        >

        <label for="langue">Langue</label>
        <input
          type="text"
          id="langue"
          name="langue"
          value="<%= auteur.langue %>"
          required
        >

        <button type="submit">Enregistrer</button>
      </form>

      <a href="/auteurs/<%= auteur.id_auteur %>">Annuler</a>
    </main>

    <%- include('../partials/footer') %>
  </body>
</html>