<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Ton CSS -->
  <link rel="stylesheet" href="/styles/styles.css">

  <!-- Bootstrap (comme sur la page d'accueil) -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>

  <title>Liste des auteurs</title>
</head>
<body class="bg-light">
  <!-- Header global -->
  <%- include('../partials/header') %>

  <main class="container py-5">
    <!-- Titre + bouton d’ajout -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1 class="h2 mb-0">Liste des auteurs</h1>
      <a href="/auteurs/new" class="btn btn-primary">
        Ajouter un auteur
      </a>
    </div>

    <!-- Liste des auteurs -->
    <% if (auteurs && auteurs.length > 0) { %>
      <div class="row g-4">
        <% auteurs.forEach(auteur => { %>
          <div class="col-12">
            <div class="card">
              <div class="card-body d-flex">
                <!-- Colonne image (même logique que la zone "Aucune image" des articles) -->
                <div
                  class="d-flex flex-column justify-content-center align-items-center me-4"
                  style="width: 150px; min-width: 150px;"
                >
                  <% if (auteur.photo) { %>
                    <img src="<%= auteur.photo %>" alt="<%= auteur.nom %>" class="img-fluid rounded">
                  <% } else { %>
                    <span class="text-muted">Aucune image</span>
                  <% } %>
                </div>

                <!-- Colonne infos + boutons -->
                <div class="flex-grow-1">
                  <h5 class="card-title mb-2">
                    <%= auteur.prenom %> <%= auteur.nom %>
                  </h5>

                  <% if (auteur.nationalite) { %>
                    <p class="mb-1">
                      <strong>Nationalité :</strong> <%= auteur.nationalite %>
                    </p>
                  <% } %>

                  <% if (auteur.langue) { %>
                    <p class="mb-3">
                      <strong>Langue :</strong> <%= auteur.langue %>
                    </p>
                  <% } %>

                  <div>
                    <a
                      href="/auteurs/<%= auteur.id_auteur %>"
                      class="btn btn-sm btn-primary me-2"
                    >
                      Profile
                    </a>

                    <a
                      href="/auteurs/<%= auteur.id_auteur %>/edit"
                      class="btn btn-sm btn-outline-secondary me-2"
                    >
                      Edit
                    </a>

                    <form
                      action="/auteurs/<%= auteur.id_auteur %>/delete"
                      method="post"
                      class="d-inline"
                      onsubmit="return confirm('Supprimer cet auteur ?');"
                    >
                      <button type="submit" class="btn btn-sm btn-outline-danger">
                        Delete
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="alert alert-info">
        Aucun auteur pour le moment. Vous pouvez en créer un avec le bouton
        <strong>« Ajouter un auteur »</strong>.
      </div>
    <% } %>
  </main>

  <!-- Footer global -->
  <%- include('../partials/footer') %>
</body>
</html>