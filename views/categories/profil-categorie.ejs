<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'Profil de la categorie' }) %>
<body>
    <%- include('../partials/header') %>
    <main class="wrapper">
        <h1>Profil de la categorie</h1>
        <div class="card">
            <div class="card-body">
                <h5 class="card-title"><%= categorie.nom_categorie %> </h5>
                <p class="card-text"> Description <%= categorie.description %></p>
            </div>
            <div class="card-footer">
                <a href="/categories/edit/<%= categorie.id_categorie" class="btn btn-primary">Modifier</a>
                <form action="/categories/<%= categorie.id_categorie %>?_method=DELETE" method="POST">
                    <button type="submit" class="btn btn-danger">Supprimer</button>   
                </form>
                <a href="/categories/list-categorie" class="btn btn-secondary">Retour à la liste</a>
            </div>
        </div>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>