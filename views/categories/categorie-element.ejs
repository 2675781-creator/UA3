<div class="card" style="width: 18rem;">
    <img src="<%= (categorie.image) ? categorie.image : 'https://placehold.co/600x400?text=Pas+d+image' %>" 
    class="card-img-top" 
    alt="<%= categorie.nom_categorie %>">
    <div class="card-body">
        <h5 class="card-title">
            <%= categorie.nom_categorie %>
        </h5>
        <p class="card-text">
            description:<%= categorie.description %>.
        </p>
    </div>
    <div class="card-footer"> 
        <form action="/categories/<%= categorie.id_categorie %>/edit" method="GET">
            <button class="btn btn-primary">Modifier</button>
        </form>
        <form action="/categories/<%=categorie.id_categorie %>?_method=DELETE" method="POST">
            <button class="btn btn-danger">Supprimer</button>
        </form>
        
        <form action="/categories/<%=categorie.id_categorie %>" method="GET">
            <button type="submit" class="btn btn-success">Profil</button>
        </form>
    </div>
</div>