<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head', { title: 'Liste des catégories' }) %>
<body>
    <%- include('../partials/header') %>
    <main class="wrapper">
        <h1 class="mb-4">Liste des catégories</h1>
        <div class="row g-4">
            <% categories.forEach(categorie => { %>
                <div class="col-md-4 col-sm-6">
                    <%- include('./categorie-element', { categorie: categorie }) %>
                </div>
            <% }) %>
        </div>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>