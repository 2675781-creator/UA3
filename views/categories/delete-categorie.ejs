<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'Supprimer une categorie' }) %>
    <body>
        <%- include('../partials/header') %>
            <main class="wrapper">
                <h1>Supprimer une categorie</h1>
                <form action="/categories/<%= categorie.id_categorie %>?_method=DELETE" method="POST" enctype="multipart/form-data">
                    <div class="mb-2">
                        <label for="nom_categorie" class="form-label">Nom de la categorie</label>
                        <input type="text" class="form-control" id="nom_categorie" name="nom_categorie" value="<%= categorie.nom_categorie %>" readonly>
                    </div>
                    <div class="mb-2">
                        <label for="description" class="form-label">Description</label>
                        <input type="text" class="form-control" id="description" name="description" value="<%= categorie.description %>" readonly>
                    </div>            
                    <button class="btn btn-success" type="submit">Supprimer</button>
                </form>
            </main>
            <%- include('../partials/footer') %>
    </body>
</html>