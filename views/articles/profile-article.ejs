<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="stylesheet" href="/styles/styles.css">
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>

  <title>Profil de l’article</title>
</head>
<body class="bg-light">
  <%- include('../partials/header') %>

  <main class="container py-5">
    <a href="/articles" class="btn btn-link mb-3">&larr; Retour à la liste des articles</a>

    <% if (article) { %>
      <div class="row">
        <div class="col-md-4 mb-3">
          <% if (article.image) { %>
            <img
              src="/img/<%= article.image %>"
              alt="<%= article.titre %>"
              class="img-fluid rounded shadow-sm"
            >
          <% } else { %>
            <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-light rounded shadow-sm" style="min-height: 200px;">
              <span class="text-muted">Aucune image</span>
            </div>
          <% } %>
        </div>

        <div class="col-md-8">
          <div class="card shadow-sm">
            <div class="card-body">
              <h1 class="h4 card-title mb-3"><%= article.titre %></h1>

              <p class="mb-2">
                <strong>Status :</strong>
                <span class="<%= article.status === 'disponible' ? 'text-success' : 'text-danger' %>">
                  <%= article.status %>
                </span>
              </p>

              <p class="mb-2">
                <strong>Date de publication :</strong>
                <%= article.date_publication %>
              </p>

              <p class="mb-2">
                <strong>Quantité disponible :</strong>
                <%= article.quantite %>
              </p>

              <!-- autres infos si tu en as -->
              <% if (article.description) { %>
                <p class="mt-3"><strong>Description :</strong> <%= article.description %></p>
              <% } %>

              <div class="mt-4 d-flex flex-wrap gap-2">
                <a href="/articles/<%= article.id_article %>/edit" class="btn btn-outline-secondary btn-sm">
                  Edit
                </a>

                <form action="/articles/<%= article.id_article %>?_method=DELETE" method="post" class="d-inline">
                  <button
                    type="submit"
                    class="btn btn-outline-danger btn-sm"
                    onclick="return confirm('Supprimer cet article ?');"
                  >
                    Delete
                  </button>
                </form>

                <a href="/articles" class="btn btn-primary btn-sm">
                  Retour à la liste
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% } else { %>
      <div class="alert alert-warning">
        Aucun article trouvé.
      </div>
    <% } %>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>