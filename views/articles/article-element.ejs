<div class="article-card">
  <img src="/img/<%= article.image %>" alt="<%= article.titre %>" />

  <p><strong>Titre :</strong> <%= article.titre %></p>
  <p><strong>status :</strong> <%= article.status %></p>
  <p><strong>Date de publication :</strong> <%= article.date_publication %></p>
  <p><strong>Quantité disponible :</strong> <%= article.quantite %></p>

  <!-- Actions -->
  <a href="/articles/<%= article.id_article %>/edit">
    <button type="button">Edit</button>
  </a>

  <form action="/articles/<%= article.id_article %>/delete" method="post" style="display:inline;">
    <button type="submit">Delete</button>
  </form>

  <a href="/articles/<%= article.id_article %>">
    <button type="button">Profile</button>
  </a>
</div>