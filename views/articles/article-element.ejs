<div class="card" style="width: 18rem;">
    <img src="<%= article.image %>" class="card-img-top" alt="<%= article.titre %>">
    <div class="card-body">
        <h5 class="card-title">
            Titre:<%= article.titre %>
        </h5>
        <p class="card-text">
            status:<%= article.status %>.
        </p>
        <p class="card-text">
            identifiant de l'auteur:<%= article.id_auteur %>
        </p>
        <p class="card-text">
            identifiant de la categorie:<%= article.id_categorie %>
        </p>
        <p class="card-text">
            identifiant de l'employe:<%= article.id_employe %>
        </p>
    </div>
    </div>
    <div class="card-footer"> 
        <button class="btn btn-primary">Edit</button>
        <button class="btn btn-danger">Delete</button>
        <button class="btn btn-success">Profile</button>
    </div>

    <!-- Texte -->
    <div class="col-md-9">
      <div class="card-body">
        <h5 class="card-title mb-2"><%= article.titre %></h5>

        <p class="mb-1">
          <strong>Status :</strong>
          <span class="<%= article.status === 'disponible' ? 'text-success' : 'text-danger' %>">
            <%= article.status %>
          </span>
        </p>

        <p class="mb-1">
          <strong>Date de publication :</strong>
          <%= article.date_publication %>
        </p>

        <p class="mb-3">
          <strong>Quantité disponible :</strong>
          <%= article.quantite %>
        </p>

        <div class="d-flex flex-wrap gap-2">
          <!-- Profil / détails -->
          <a href="/articles/<%= article.id_article %>" class="btn btn-sm btn-outline-primary">
            Profile
          </a>

          <!-- Edit : page de formulaire GET (à toi de définir la route) -->
          <a href="/articles/<%= article.id_article %>/edit" class="btn btn-sm btn-outline-secondary">
            Edit
          </a>

          <!-- Delete : méthode DELETE sur /articles/:id_article -->
          <form action="/articles/<%= article.id_article %>?_method=DELETE" method="post" class="d-inline">
            <button
              type="submit"
              class="btn btn-sm btn-outline-danger"
              onclick="return confirm('Supprimer cet article ?');"
            >
              Delete
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>