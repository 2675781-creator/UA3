<!DOCTYPE html>
<html lang="fr">
  <head>
    <%- include('../partials/head', { title: title }) %>
  </head>
  <body>
    <%- include('../partials/header') %>

    <main class="wrapper">
      <h1>Modifier l'article : <%= article.titre %></h1>

      <!-- IMPORTANT : on envoie vers /articles/:id_article/edit en POST -->
      <form action="/articles/<%= article.id_article %>/edit" method="post">
        <label>Titre</label>
        <input type="text" name="titre" value="<%= article.titre %>" />

        <label>Status</label>
        <input type="text" name="status" value="<%= article.status %>" />

        <label>Date de publication</label>
        <input
          type="date"
          name="date_publication"
          value="<%= article.date_publication %>"
        />

        <label>Quantité disponible</label>
        <input
          type="number"
          name="quantite"
          value="<%= article.quantite %>"
        />

        <button type="submit">Enregistrer</button>
      </form>

      <a href="/articles">Annuler</a>
    </main>

    <%- include('../partials/footer') %>
  </body>
</html>