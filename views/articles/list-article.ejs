<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head', { title: 'Liste des articles' }) %>
  <body>
    <%- include('../partials/header') %>

    <main class="wrapper">
      <h1>Liste des articles</h1>

      <!-- Lien pour ajouter un article -->
      <p>
        <a href="/articles/new">Ajouter un article</a>
      </p>

      <div class="list">
        <% articles.forEach(article => { %>
          <%- include('./article-element', { article: article }) %>
        <% }) %>
      </div>
    </main>

    <%- include('../partials/footer') %>
  </body>
</html>