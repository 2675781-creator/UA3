<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Ton CSS -->
  <link rel="stylesheet" href="/styles/styles.css">

  <!-- Bootstrap (comme sur la page d'accueil) -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>

  <title>Liste des articles</title>
</head>
<body class="bg-light">
  <!-- Header global -->
  <%- include('../partials/header') %>

  <main class="container py-5">
    <!-- Titre + bouton d’ajout -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1 class="h2 mb-0">Liste des articles</h1>
      <a href="/articles/new" class="btn btn-primary">
        Ajouter un article
      </a>
    </div>

    <!-- Liste des articles -->
    <% if (articles && articles.length > 0) { %>
      <div class="row g-4">
        <% articles.forEach(article => { %>
          <div class="col-12">
            <%- include('./article-element', { article: article }) %>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="alert alert-info">
        Aucun article pour le moment. Vous pouvez en créer un avec le bouton
        <strong>« Ajouter un article »</strong>.
      </div>
    <% } %>
  </main>

  <!-- Footer global -->
  <%- include('../partials/footer') %>
</body>
</html>