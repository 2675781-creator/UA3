<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
</head>
<body>
  <% if (user) { %>
    <p>Connecté en tant que <strong><%= user.nom %></strong> (<%= user.role %>)</p>
    <p><a href="/auth/logout">Se déconnecter</a></p>
  <% } %>

  <h1>Gestion des utilisateurs</h1>

  <p><a href="/users/new">Créer un nouvel utilisateur</a></p>

  <table border="1" cellpadding="8">
    <thead>
      <tr>
        <th>ID</th>
        <th>Nom</th>
        <th>Email</th>
        <th>Rôle</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach(u => { %>
        <tr>
          <td><%= u.id_user %></td>
          <td><%= u.nom %></td>
          <td><%= u.email %></td>
          <td><%= u.role %></td>
          <td>
            <a href="/users/<%= u.id_user %>/edit">Modifier</a>

            <% if (u.id_user !== user.id_user) { %>
              <!-- éviter de se supprimer soi-même au début -->
              <form action="/users/<%= u.id_user %>/delete" method="POST" style="display:inline;">
                <button type="submit" onclick="return confirm('Supprimer cet utilisateur ?');">
                  Supprimer
                </button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <p><a href="/">Retour à l'accueil</a></p>
</body>
</html>