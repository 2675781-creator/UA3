<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'Supprimer un emprunt' }) %>
    <body>
        <%- include('../partials/header') %>
            <main class="wrapper">
                <h1>Supprimer un emprunt</h1>
                <form action="/emprunts/<%= emprunt.id_client %>/<%= emprunt.id_article %>/?_method=DELETE" method="POST" enctype="multipart/form-data">
                    <div class="mb-2">
                        <label for="id_client" class="form-label">identifiant du client</label>
                        <input type="number" class="form-control" id="id_client" name="id_client" value="<%= emprunt.id_client %>" readonly>
                    </div>
                    <div class="mb-2">
                        <label for="id_article" class="form-label">identifiant article</label>
                        <input type="number" class="form-control" id="id_article" name="id_article" value="<%= emprunt.id_article %>" readonly>
                    </div>
                    <div class="mb-2">
                        <label for="date_emprunt" class="form-label">Date emprunt</label>
                        <input type="date" class="form-control" id="date_emprunt" name="date_emprunt" value="<%= emprunt.date_emprunt %>" readonly>
                    </div>
                    <div class="mb-2">
                        <label for="date_retour" class="form-label">Date de retour</label>
                        <input type="date" class="form-control" id="date_retour" name="date_retour" value="<%= emprunt.date_retour %>" readonly>
                    </div>
                    <button class="btn btn-success" type="submit">Supprimer</button>
                </form>
            </main>
            <%- include('../partials/footer') %>
    </body>
</html>