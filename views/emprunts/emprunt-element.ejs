<div class="card" style="width: 18rem;">
    <% if (emprunt.image) { %>
        <img src="<%= emprunt.image %>" class="card-img-top" alt="Image pour l'emprunt du <%= emprunt.date_emprunt %>">
    <% } else { %>
        <img src="https://placehold.co/600x400?text=Pas+d+image" class="card-img-top" alt="Pas d'image disponible">
    <% } %>
    <div class="card-body">
        <h5 class="card-title">Client ID: <%= emprunt.id_client %></h5>
        <p class="card-text">Article ID: <%= emprunt.id_article %></p>
        <p class="card-text">
            Date de l'emprunt: <%= new Date(emprunt.date_emprunt).toLocaleDateString("fr-FR") %>
        </p>
        <p class="card-text">
            Date de retour: 
            <% if (emprunt.date_retour) { %>
                <%= new Date (emprunt.date_retour).toLocaleDateString("fr-FR") %>
            <% } else { %>
                (En cours)
            <% } %>
        </p>
    </div>
    <div class="card-footer d-flex justify-content-between">
        <form action="/emprunts/<%= emprunt.id_client %>/<%= emprunt.id_article %>/edit" method="GET">
            <button type="submit" class="btn btn-primary">Modifier</button>
        </form>
        <form action="/emprunts/<%= emprunt.id_client %>/<%= emprunt.id_article %>?_method=DELETE" method="POST">
            <button class="btn btn-danger">Supprimer</button>
        </form>
        
        <form action="/emprunts/<%= emprunt.id_client %>/<%= emprunt.id_article %>" method="GET">
            <button type="submit" class="btn btn-success">Profil</button>
        </form>
    </div>
</div>
