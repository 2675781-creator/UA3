<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head', { title: 'Ajouter un emprunt' }) %>

    <body>
        <%- include('../partials/header') %>
            <main class="wrapper">
                <h1>Ajouter un emprunt</h1>
                <form action="/emprunts" method="POST">
                    <div class="mb-2">
                        <label for="id_client" class="form-label">Identifiant client</label>
                        <input required type="number" class="form-control" id="id_client" name="id_client" placeholder="Entrez l'id du client">
                    </div>
                    <div class="mb-2">
                        <label for="id_article" class="form-label">Identifiant article</label>
                        <input required type="number" class="form-control" id="id_article" name="id_article" placeholder="Entrez l'id de l'article">
                    </div>
                    <div class="mb-2">
                        <label for="date_emprunt" class="form-label">Date d'emprunt</label>
                        <input type="date" class="form-control" id="date_emprunt" name="date_emprunt" placeholder="Entrez la date de l'emprunt">
                    </div>
                    <div class="mb-2">
                        <label for="date_retour" class="form-label">Date de retour</label>
                        <input type="date" class="form-control" id="date_retour" name="date_retour" placeholder="Entrez la date de retour">
                    </div>
                    <button class="btn btn-success" type="submit">Ajouter</button>
                </form>
            </main>
            <%- include('../partials/footer') %>
    </body>
</html>