<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'Liste des emprunts' }) %>
<body>
    <%- include('../partials/header') %>
    <main class="wrapper">
        <h1 class="mb-4">Liste des emprunts</h1>
        <div class="row g-4">
            <% emprunts.forEach(emprunt => { %>
                <div class="col-md-4 col-sm-6">
                    <%- include('./emprunt-element', { emprunt: emprunt }) %>
                </div>
            <% }) %>
        </div>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>
