<div class="card" style="width: 18rem;">
    <img src="<%= employe.image %>" class="card-img-top" alt="<%= employe.nom %>">
    <div class="card-body">
        <h5 class="card-title">
            Nom:<%= employe.nom %>
        </h5>
        <p class="card-text">
            prenom:<%= employe.prenom %>.
        </p>
        <p class="card-text">
            role:<%= employe.role %>
        </p>
         <p class="card-text">
            date_embauche:<%= employe.date_embauche %>
        </p>
    </div>
    </div>
    <div class="card-footer"> 
        <form action="/employes/<%= employe.id_employe %>/edit" method="GET">
            <button type="submit" class="btn btn-primary">Modifier</button>
        </form>
        <form action="/employes/<%= employe.id_employe %>?_method=DELETE" method="POST">
            <button class="btn btn-danger">Supprimer</button>
        </form>
        
        <form action="/employes/<%= employe.id_employe %>" method="GET">
            <button type="submit" class="btn btn-success">Profil</button>
        </form>
        
    </div>

</div>