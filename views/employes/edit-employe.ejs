<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head', { title: "Modifier un employe' }) %>
    <body>
        <%- include('../partials/header') %>

        <% const formData = (typeof oldData !== 'undefined') ? oldData : {}; %>
            <main class="wrapper">
                <h1>Modfier un employe</h1>
                <form action="/employes/<%= employeData.id_employe %>?_method=PUT" method="POST">
                    <div class="mb-2">
                        <label for="nom" class="form-label">Nom</label>
                        <input required type="text" class="form-control <%= (typeof errors !== 'undefined' && errors.nom) ? 'is-invalid' : '' %>" id="nom" name="nom" value="<%=  formData.nom || employeData.nom %>" placeholder="Entrez le nom">
                        <% if(typeof errors !== 'undefined' && errors.nom) { %>
                            <div class="invalid-feedback"><%= errors.nom %></div>
                        <% } %>
                    </div>
        
                    <div class="mb-2">
                        <label for="prenom" class="form-label">Prénom</label>
                        <input type="text" class="form-control <%= (typeof errors !== 'undefined' && errors.prenom) ? 'is-invalid' : '' %>" id="prenom" name="prenom" value="<%= formData.prenom || employeData.prenom %>" placeholder="Entrez le prenom">
                        <% if(typeof errors !== 'undefined' && errors.prenom) { %>
                            <div class="invalid-feedback"><%= errors.prenom %></div>
                        <% } %>
                    </div>

                    <div class="mb-2">
                        <label for="age" class="form-label">Âge</label>
                        <input type="number" class="form-control" id="age" name="age" value="<%= formData.age || employeData.age %>" placeholder="Entrez l'age">
                    </div>
                    <div class="mb-2">
                        <label for="role" class="form-label">Role</label>
                        <select id="role" name="role" class="form-select" aria-label="Large">
                            <option selected>Ouvrir le menu des identifiant de chaque role</option>
                            <option value="admin">Admin</option>
                            <option value="secretaire">Secretaire</option>
                            <option value="gestionnaire">Gestionnaire</option>
                            <option value="gardien">Gardien</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label for="date_embauche" class="form-label">Date embauche</label>
                        <input type="date" class="form-control" id="date_embauche" name="date_embauche" value="<%= employeData.date_embauche %>" placeholder="Entrez la date ">
                    </div>
                    <div class="mb-2">
                        <label for="numero_tache" class="form-label">Numero tache</label>
                        <input type="number" class="form-control" id="numero_tache" name="numero_tache" value="<%= employeData.numero_tache %>">
                    </div>
                    <button class="btn btn-success" type="submit">Modifier</button>
                </form>
            </main>
            <%- include('../partials/footer') %>
    </body>
</html>