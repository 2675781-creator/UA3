<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head', { title: 'Ajouter un client' }) %>
    <body>
        <%- include('../partials/header') %>
            <main class="wrapper">
                <h1>Ajouter client</h1>
                <% if (errors) { %>
                    <div class="alert alert-danger">
                        <% errors.forEach(error => { %>
                            <p><%= error.msg %></p>
                        <% }) %>    
                    </div>
                <% } %>
                <form action="/clients" method="POST">
                    <div class="mb-2">
                        <label for="nom" class="form-label">Nom</label>
                        <input required type="text" class="form-control" id="nom" name="nom" 
                                value="<%= oldInput?.nom || '' %>" placeholder="Entrez le nom">
                    </div>
                    <div class="mb-2">
                        <label for="prenom" class="form-label">Prenom</label>
                        <input required type="text" class="form-control" id="prenom" name="prenom" value="<%= oldInput?.prenom || '' %>" placeholder="Entrez le prenom">
                    </div>
                    <div class="mb-2">
                        <label for="article_prefere" class="form-label">Article prefere</label>
                        <input type="text" class="form-control" id="article_prefere" name="article_prefere" value="<%= oldInput?.article_prefere || '' %>" placeholder="Entrez l'article prefere">
                    </div>
                    <div class="mb-2">
                        <label for="id_article" class="form-label"> ID article</label>
                        <select id="id_article" name="id_article" class="form-select" required>
                            <option value="">Choisissez un article</option>
                            <% articles.forEach(article => { %>
                                <option value="<%= article.id_article %>"
                                    <%= oldInput?.id_article == article.id_article ? 'selected' : '' %>>
                                    <%= article.id_article %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <button class="btn btn-success" type="submit">Ajouter</button>
                </form>
            </main>
            <%- include('../partials/footer') %>
    </body>
</html>