<div class="card" style="width: 18rem;">
    <img src="<%= client.image %>" class="card-img-top" alt="<%= client.nom %>">
    <div class="card-body">
        <h5 class="card-title">
            Nom:<%= client.nom %>
        </h5>
        <p class="card-text">
            prenom:<%= client.prenom %>.
        </p>
        <p class="card-text">
            article_prefere:<%= client.article_prefere %>
        </p>
         <p class="card-text">
            id_article:<%= client.id_article %>
        </p>
    </div>
    
    <div class="card-footer"> 
       
        <form action="/clients/<%= client.id_client %>/edit" method="GET">
            <button type="submit" class="btn btn-primary">Modifier</button>
        </form>
        
        <form action="/clients/<%= client.id_client %>?_method=DELETE" method="POST">
            <button type="submit" class="btn btn-danger">Supprimer</button>
        </form>
        <form action="/clients/<%= client.id_client %>" method="GET">
            <button type="submit" class="btn btn-success">Profil</button>
        </form>
    </div>
</div>